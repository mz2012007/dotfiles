#!/usr/bin/env bash
# dotfiles-sync.sh
# Git sync script using SSH only (no HTTPS, no credentials store)
# Interactive push/pull choice with CLI options

set -euo pipefail
IFS=$'\n\t'

# --------------------------
# Color support
# --------------------------
if [[ -t 1 ]]; then
  RED="\033[31m"
  GREEN="\033[32m"
  YELLOW="\033[33m"
  BLUE="\033[34m"
  CYAN="\e[0;36m"
  RESET="\033[0m"
else
  RED="" GREEN="" YELLOW="" BLUE="" RESET="" CYAN=""
fi

info() { echo -e "${BLUE}ℹ️  $*${RESET}"; }
warn() { echo -e "${YELLOW}⚠️  $*${RESET}"; }
success() { echo -e "${GREEN}✅ $*${RESET}"; }
error() {
  echo -e "${RED}❌ $*${RESET}"
  exit 1
}

# --------------------------
# Handle Ctrl+C
# --------------------------
trap 'error "Operation cancelled by user"' INT

# --------------------------
# Default values
# --------------------------
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_FILE="$SCRIPT_DIR/$(basename "$0")"
REPO_DIR="$HOME/dotfiles"
REMOTE_NAME="dotfiles"
SSH_REMOTE="git@github.com:mz2012007/${REMOTE_NAME}.git"
BRANCH="main"
SSH_KEY="$HOME/.ssh/id_ed25519"

# --------------------------
# Functions
# --------------------------
update_script_variables() {
  local vars=("REPO_DIR" "REMOTE_NAME" "BRANCH")

  cp "$SCRIPT_FILE" "$SCRIPT_FILE.tmp"

  while true; do
    echo
    echo "Select variable to update:"
    echo "0) Exit"

    for i in "${!vars[@]}"; do
      echo "$((i + 1))) ${vars[$i]}"
    done

    read -rp "Enter choice: " choice

    if [[ "$choice" == "0" ]]; then
      break
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#vars[@]})); then

      var_name="${vars[$((choice - 1))]}"

      read -rp "Enter new value for $var_name: " new_value

      if grep -q "^$var_name=" "$SCRIPT_FILE"; then
        sed -i "s|^$var_name=.*|$var_name=\"$new_value\"|" "$SCRIPT_FILE"
        info "Updated $var_name"
      else
        sed -i "1a$var_name=\"$new_value\"" "$SCRIPT_FILE"
        info "Added $var_name"
      fi

    else
      warn "Invalid choice"
    fi

  done
}

show_help() {
  echo -e "${BLUE}Usage:${RESET} $0 [options]"
  echo "Options:"
  echo "  -b <branch>   Use specified branch (default: main)"
  echo "  -h            Show this help message"
  exit 0
}

ssh_setup() {
  warn "SSH key not found at $SSH_KEY. Run ssh-setup first."
  "$HOME/dotfiles/ssh.init"
}

replace_https_with_ssh() {
  if git remote get-url "$REMOTE_NAME" >/dev/null 2>&1; then
    CURRENT_URL="$(git remote get-url "$REMOTE_NAME")"
    if [[ "$CURRENT_URL" != git@github.com:* ]]; then
      warn "Replacing HTTPS remote with SSH"
      git remote set-url "$REMOTE_NAME" "$SSH_REMOTE"
    else
      info "SSH remote already configured"
    fi
  fi
}

prepare_repo() {
  if [ ! -d "$REPO_DIR" ]; then
    echo "Folder $REPO_DIR not found."
    echo "0) no choice"
    echo "1) Create and clone repo "
    echo "2) create without clone"
    read -rp "[0-2]: " answer
    case "$answer" in
    0) ;;
    1)
      info "Creating folder and cloning repo..."
      mkdir -p "$REPO_DIR"
      git clone -b "$BRANCH" "$SSH_REMOTE" "$REPO_DIR"
      ;;
    2)
      info "Creating folder without pull..."
      mkdir -p "$REPO_DIR"
      ;;
    *)
      warn "Repo not created. Exiting."
      exit 1
      ;;
    esac
  else
    cd "$REPO_DIR"
  fi
}

create_new_repo() {
  info "git Initializing..."
  git init
  success "git initialized"

  info "Touch README..."
  touch README.md
  success "Create README file"

  info "Adding README..."
  git add README.md
  success "README added"

  info "First commit..."
  git commit -S -m "Initial commit"
  success "First commit"

  info "Adding SSH remote..."
  git remote add "$REMOTE_NAME" "$SSH_REMOTE"
  success "Remote added"

  info "First push..."
  git push -u "$REMOTE_NAME" "$BRANCH"
  success "First push"
}

create_pull_repo() {
  info "Adding SSH remote"
  git remote add "$REMOTE_NAME" "$SSH_REMOTE"
  info "Pulling Repo..."
  git pull "$REMOTE_NAME" "$BRANCH" || error "During pull"
  success "Pull completed"
}

pull_repo() {
  # Ensure branch
  git checkout "$BRANCH" 2>/dev/null || git checkout -b "$BRANCH"

  info "Pulling latest changes..."
  git pull "$REMOTE_NAME" "$BRANCH"
  success "Pull completed"
}

pull_rebase_repo() {
  # Ensure branch
  git checkout "$BRANCH" 2>/dev/null || git checkout -b "$BRANCH"

  info "Pulling latest changes with rebase..."
  if git pull --rebase "$REMOTE_NAME" "$BRANCH"; then
    success "Pull --rebase completed successfully"
  else
    warn "Conflicts detected during rebase. Resolve them manually!"
  fi
}

push_commit_repo() {

  # ==========================================
  # Ensure branch exists
  # ==========================================

  if ! git checkout "$BRANCH" 2>/dev/null; then
    git checkout -b "$BRANCH"
  fi

  echo

  # ==========================================
  # Commit message (auto fallback)
  # ==========================================

  printf "%b" "${CYAN}Commit message (optional):${RESET} "
  read -r commit_msg

  if [[ -z "${commit_msg// /}" ]]; then
    commit_msg="auto: update $(date '+%Y-%m-%d %H:%M:%S')"
  fi

  # ==========================================
  # Stage changes
  # ==========================================

  info "Staging changes..."
  git add -A

  # ==========================================
  # Check staged changes
  # ==========================================

  if git diff --cached --quiet; then
    warn "No changes to commit"
    return 0
  fi

  # ==========================================
  # Commit
  # ==========================================

  git commit -S -m "$commit_msg"
  info "Commit created"

  # ==========================================
  # Push
  # ==========================================

  info "Pushing..."

  git push "$REMOTE_NAME" "$BRANCH" --quiet

  # ==========================================
  # Sync safely (fetch + rebase)
  # ==========================================

  info "Syncing with remote..."

  git pull --rebase --quiet || {
    warn "Rebase conflict detected"
    return 1
  }

  success "Push completed"
}

push_force_repo() {

  # Ensure branch
  git checkout "$BRANCH" 2>/dev/null || git checkout -b "$BRANCH"

  info "Staging changes..."
  git add -A
  if git diff --cached --quiet; then
    warn "No changes to commit"
  else
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
      git commit --amend --no-edit
      info "Amended last commit"
    else
      git commit -S -m "chore: initial commit"
      info "Initial commit created"
    fi
  fi
  info "Force pushing..."
  git push -f "$REMOTE_NAME" "$BRANCH"
  success "Force push completed"
}

# --------------------------
# Parse CLI args
# --------------------------
while getopts ":b:h" opt; do
  case $opt in
  b) BRANCH="$OPTARG" ;;
  h) show_help ;;
  \?)
    warn "Unknown option: -$OPTARG"
    show_help
    ;;
  :)
    warn "Option -$OPTARG requires an argument"
    show_help
    ;;
  esac
done

# --------------------------
# Main function
# --------------------------
dotfiles_sync() {
  # Sanity checks
  command -v git >/dev/null 2>&1 || error "git is not installed"
  command -v ssh >/dev/null 2>&1 || error "ssh is not installed"

  # Ensure & setub SSH key
  #  [ -f "$SSH_KEY" ] || ssh_setup

  prepare_repo

  # Ensure git repo
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "The dire $REPO_DIR is existed ,but there is no git. Would you Create or clone repo?"
    echo -e "${BLUE}Choose operation:${RESET}"
    echo "0) contiue"
    echo "1) create new"
    echo "2) create and pull"
    read -rp "Enter choice [0-2]: " choice

    case "$choice" in
    0) ;;
    1) create_new_repo ;;
    2) create_pull_repo ;;
    *) warn "Invalid choice, try again." ;;
    esac
  fi

  # Ensure local user config
  git config user.name >/dev/null 2>&1 || git config user.name "MohamedZaki"
  git config user.email >/dev/null 2>&1 || git config user.email "mohamedgamer139@gmail.com"

  # --------------------------
  # Run copy script if exists
  # --------------------------
  if [ -x "./cp.bak" ]; then
    info "Running cp.sh"
    ./cp.bak
  else
    warn "cp.sh not found or not executable, skipping"
  fi

  # --------------------------
  # Interactive choice
  # --------------------------
  while true; do
    echo -e "${BLUE}Choose operation:${RESET}"
    echo "0) exit"
    echo "1) push with commit"
    echo "2) push --force"
    echo "3) pull"
    echo "4) pull --rebase"
    echo "5) change variables"
    #echo "6) replace https with ssh"
    read -rp "Enter choice [0-5]: " choice

    case "$choice" in
    0) exit ;;
    1)
      push_commit_repo
      break
      ;;
    2)
      push_force_repo
      break
      ;;
    3)
      pull_repo
      break
      ;;
    4)
      pull_rebase_repo
      break
      ;;
    5) update_script_variables ;;
    #6) replace_https_with_ssh ;;
    *) warn "Invalid choice, try again." ;;
    esac
  done
}

# --------------------------
# Run main function
# --------------------------
dotfiles_sync

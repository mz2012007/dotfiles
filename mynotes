#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
# basic mounts
mount -t proc proc /proc || true
mount -t sysfs sys /sys || true
mount -t devtmpfs dev /dev || true

# create device nodes for fallback
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/null ]   || mknod /dev/null c 1 3

# optional: try to load modules (if insmod present)
if [ -x /bin/insmod ]; then
  /bin/insmod /lib/isofs.ko 2>/dev/null || true
  /bin/insmod /lib/sr_mod.ko 2>/dev/null || true
fi

# search and mount ISO (common device paths)
echo "Searching for Live squashfs..."
for device in /dev/sr0 /dev/cdrom /dev/disk/by-label/* /dev/disk/by-uuid/*; do
  [ -e "$device" ] || continue
  mount -t iso9660 -o ro "$device" /mnt 2>/dev/null && break
  # also try device as loop file (if booted from file)
  mount -o loop "$device" /mnt 2>/dev/null && break
done

# if not found, try /live path on any mounted FS
if [ ! -f /mnt/live/rootfs.squashfs ]; then
  for m in /mnt/*; do
    [ -f "$m/live/rootfs.squashfs" ] && { umount /mnt 2>/dev/null || true; mount -o loop "$m" /mnt 2>/dev/null && break; }
  done
fi

# mount squashfs
if [ -f /mnt/live/rootfs.squashfs ]; then
  echo "Found rootfs.squashfs — mounting..."
  mkdir -p /lower /newroot /upper /upper/upper /upper/work
  mount -o loop /mnt/live/rootfs.squashfs /lower || { echo "Failed mounting squashfs"; exec /bin/sh; }

  # optional overlay (RW in RAM)
  mount -t tmpfs tmpfs /upper
  mount -t overlay overlay -o lowerdir=/lower,upperdir=/upper/upper,workdir=/upper/work /newroot || {
      echo "Overlay failed — falling back to direct squashfs"
      mount --move /lower /newroot || { echo "Cannot move lower"; exec /bin/sh; }
  }

  umount /mnt 2>/dev/null || true
  exec /sbin/switch_root /newroot /sbin/init
else
  echo "Live rootfs not found — dropping to shell"
  exec /bin/sh
fi
EOF


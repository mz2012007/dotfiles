#!/bin/sh
# =====================================
# Custom /sbin/init for Void Linux
# Root filesystem is already mounted
# =====================================

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/
export TERM=linux

echo "[init] Starting Void Linux init..."

# 1️⃣ Mount essential virtual filesystems (safety)
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sysfs /sys
mountpoint -q /dev  || mount -t devtmpfs devtmpfs /dev

# 2️⃣ Create required directories
mkdir -p /run /tmp
chmod 1777 /tmp

# 3️⃣ Setup hostname (optional)
[ -f /etc/hostname ] && hostname "$(cat /etc/hostname)"

# 4️⃣ Start udev (important for devices)
if [ -x command -v udevd || command -v /usr/libexec/udevd || /usr/bin/udevd ]; then
    echo "[init] Starting udev..."
    udevd --daemon
    udevadm trigger

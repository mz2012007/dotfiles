nohz_full=0 #reduce interrupts on core
tsc=nowatchdog #using TSC stable
intel_pstate=disable #using acpi-cpufreq
processor.max_cstate=1 #reduce latency but increase power
idle=poll #make cpu 100% all time
idle=halt

### ram
zswap.enabled=1
zswap.compressor=lz4
zswap.max_pool_percent=25
vm.swappiness=180
page_alloc.shuffle=1

## I/O
elevator=bfq
scsi_mod.use_blk_mq=1

## GPU
i915.fastboot=1
i915.enable_psr=0

## Network
tcp_fastopen=3



                   [ rofi ]
rofi -show -theme ~/.config/rofi/dmenu.rasi

                   [ virables environment ]
export PATH="$HOME/.nix-profile/bin:$PATH"
export PATH="$HOME/my\ config/myroot/myhome/.config:$PATH"

             

#!/usr/bin/env bash

# --------------------------
# Trap SIGINT
# --------------------------
cleanup() {
  pkill -P $$ 2>/dev/null
  echo
  success "Files copied so far: $count/$total"
  not_copied=$((total - count))
  info "File not copied $not_copied"
  echo -e "\n${RED}Interrupted by user!${RESET}"
  # Kill all subprocesses of this script
  exit 1
}

# --------------------------
# Colors
# --------------------------
if [[ -t 1 ]]; then
  RED=$'\e[31m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  BLUE=$'\e[34m'
  RESET=$'\e[0m'
else
  RED="" GREEN="" YELLOW="" BLUE="" RESET=""
fi

info() { echo -e "${BLUE}ℹ $*${RESET}"; }
success() { echo -e "${GREEN}✔ $*${RESET}"; }
error() {
  echo -e "${RED}✘ $*${RESET}"
  exit 1
}

# --------------------------
# Global data
# --------------------------
declare -A cp_map
BAR_CHAR='|'
EMPTY_CHAR=' '
files=()
total=0

# --------------------------
# Terminal helpers
# --------------------------
init-term() {
  printf '\n'
  printf '\e7'
  printf '\e[%d;%dr' 0 "$((LINES - 1))"
  printf '\e8'
  printf '\e[1A'
}

deinit-term() {
  printf '\e7'
  printf '\e[%d;%dr' 0 "$LINES"
  printf '\e[%d;%dH' "$LINES" 0
  printf '\e[0K'
  printf '\e8'
}

# --------------------------
# Progress bar
# --------------------------
progress-bar() {
  local current=$1
  local perc_done=$((current * 100 / total))
  local suffix=" $current/$total ($perc_done%)"
  local length=$((COLUMNS - ${#suffix} - 2))
  local done=$((perc_done * length / 100))
  local s='['
  for ((i = 0; i < done; i++)); do s+=$BAR_CHAR; done
  for ((i = done; i < length; i++)); do s+=$EMPTY_CHAR; done
  s+=']'
  s+=$suffix

  printf '\e7'
  printf '\e[%d;%dH' "$LINES" 0
  printf '\e[0K'
  printf '%s' "$s"
  printf '\e8'
}

# --------------------------
# Build cp_map using rsync dry-run
# --------------------------
build_cp_map() {
  local src="$1"
  local dest="$2"

  [[ -z "$src" || -z "$dest" ]] && error "Usage: $0 <src> <dest>"
  [[ ! -d "$src" ]] && error "Source not found: $src"
  [[ ! -d "$dest" ]] && mkdir -p "$dest"

  info "Counting files..."
  files=($(rsync -a --dry-run --out-format="%n" "$src/" "$dest/"))
  total=(${#files[@]} - 1)
  info "Total files to copy: $total"

  for f in "${files[@]}"; do
    cp_map["$src/$f"]="$dest/$f"
  done
}

# --------------------------
# Copy all with progress using rsync
# --------------------------
copy_all() {
  local count=0
  for src in "${!cp_map[@]}"; do
    ((count++))
    mkdir -p "$(dirname "${cp_map[$src]}")"
    info "copy $src -> ${cp_map[$src]} "
    rsync -a "$src" "${cp_map[$src]}" >/dev/null 2>&1
    success "copy $src -> ${cp_map[$src]} "

    progress-bar "$count"
  done
  echo
  success "All files copied!"
  success "Files copied so far: $count/$total"
  not_copied=$((total - count))
  info "File not copied $not_copied"

}

# --------------------------
# Main
# --------------------------
main() {
  shopt -s globstar nullglob checkwinsize
  (:)

  trap cleanup SIGINT
  trap deinit-term EXIT
  trap init-term WINCH
  init-term

  build_cp_map "$1" "$2"
  copy_all
}

main "$@"

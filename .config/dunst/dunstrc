[global]
    font = JetBrainsMono Nerd Font 10
    enable_icons = yes
    icon_position = left
    icon_theme = Papirus-Dark
    max_icon_size = 48
    frame_width = 2
    frame_color = "#89b4fa"   # blue
    separator_color = frame
    corner_radius = 12
    padding = 10
    horizontal_padding = 12
    transparency = 0
    origin = top-right
    offset = 20x20
[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#94e2d5"


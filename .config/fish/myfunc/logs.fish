######################################################################
#                               Logs                                  #
######################################################################
function logs
    find /var/log -type f -print0 \
        | xargs -0 file \
        | grep text \
        | cut -d':' -f1 \
        | xargs tail -f \
        | ccze -A \
        | awk '{ $1=strftime("%b %d %I:%M:%S %p"); print }'
end


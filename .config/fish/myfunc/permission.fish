######################################################################
#                         change root                                 #
######################################################################
function ch
    sudo ~/scripts/chroot.sh $argv
end

######################################################################
function +x
    if test (count $argv) -eq 0
        echo "Usage: +x <file>"
        return
    end
    sudo chmod +x $argv
end
complete -c +x -w chmod

######################################################################
#                              End Scripts                              #
######################################################################

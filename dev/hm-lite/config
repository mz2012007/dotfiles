# HM-Lite configuration.
#
# The file is parsed as plain data. It is never sourced and never executed
# as shell code, therefore it cannot run arbitrary commands.
# Only the keys listed below are recognised, any other key is ignored.
#
# Format: KEY=VALUE, one per line. Lines starting with "#" are comments.

# Log verbosity: ERROR, WARN, INFO or DEBUG.
HM_LOG_LEVEL=INFO

# Write an operational log to <project>/logs/hm.log. 1 enables, 0 disables.
HM_LOG_FILE=1

# Coloured output: auto, always or never.
HM_COLOR=always

# Content hashing algorithm. Only sha256 is implemented.
HM_HASH_ALGORITHM=sha256

# Number of hash characters used as the directory prefix in the content store.
HM_STORE_PREFIX_LEN=2

# Seconds a command waits for the project lock before it gives up.
HM_LOCK_TIMEOUT=10

# Allow hm apply to write to destinations outside of the user home directory.
# 0 keeps every write inside $HOME.
HM_ALLOW_OUTSIDE_HOME=0

#!/usr/bin/env bash
# sway-clipboard-rofi.sh
# Clipboard manager for Sway using Rofi and wl-clipboard

CLIP_FILE="$HOME/.cache/cliphistory.txt"

# Ensure history file exists
mkdir -p "$(dirname "$CLIP_FILE")"
touch "$CLIP_FILE"

# Add current clipboard content
if [[ "$1" == "add" ]]; then
    wl-paste -n >> "$CLIP_FILE"
    # Remove duplicates, keep last 50 entries
    tac "$CLIP_FILE" | awk '!seen[$0]++' | tac | tail -n 50 > "$CLIP_FILE"
    exit
fi

# Show Rofi menu
CHOICE=$(tac "$CLIP_FILE" | rofi -dmenu -i -p "Clipboard:")

# Copy selection back to clipboard
if [[ -n "$CHOICE" ]]; then
    echo -n "$CHOICE" | wl-copy
fi

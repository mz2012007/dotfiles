#!/usr/bin/env bash
# sway-clipboard-rofi.sh
# Improved Clipboard Manager for Sway (Wayland) using Rofi and wl-clipboard

CLIP_FILE="$HOME/.cache/cliphistory.txt"
mkdir -p "$(dirname "$CLIP_FILE")"
touch "$CLIP_FILE"

# Background watcher mode: monitor clipboard for changes
if [[ "$1" == "watch" ]]; then
    LAST=""
    while true; do
        CURRENT=$(wl-paste -n 2>/dev/null || echo "")
        if [[ -n "$CURRENT" && "$CURRENT" != "$LAST" ]]; then
            echo "$CURRENT" >> "$CLIP_FILE"
            # Remove duplicates, keep last 100
            tac "$CLIP_FILE" | awk '!seen[$0]++' | tac | tail -n 100 > "$CLIP_FILE"
            LAST="$CURRENT"
        fi
        sleep 0.5
    done
    exit
fi

# Show Rofi menu for selection
CHOICE=$(tac "$CLIP_FILE" | rofi -dmenu -i -p "Clipboard:")

# Copy selection back to clipboard
if [[ -n "$CHOICE" ]]; then
    echo -n "$CHOICE" | wl-copy
fi

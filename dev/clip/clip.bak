#!/usr/bin/env bash

SHELL="bash"

set -euo pipefail

histfile="${XDG_CACHE_HOME:-$HOME/.cache}/cliphist-custom"

NOTIFY="${CLIP_NOTIFY:-1}"

notify() {
  [ "$NOTIFY" = "1" ] || return 0
  notify-send "Clipboard" "$1" -t 1200 -u low
}

ensure_file() {
  mkdir -p "$(dirname "$histfile")"
  touch "$histfile"
}

encode() {
  printf '%s' "$1" | base64 -w0
}

decode() {
  printf '%s' "$1" | base64 -d 2>/dev/null
}

capture_clipboard() {
  clip="$(cat)"
  [ -z "${clip:-}" ] && return 1
}

write_history() {
  ensure_file

  encoded="$(encode "$clip")"

  grep -Fqx "$encoded" "$histfile" ||
    printf '%s\n' "$encoded" >>"$histfile"
}

copy_primary() {
  clip="$(wl-paste --primary 2>/dev/null || true)"
  [ -z "${clip:-}" ] && return 1

  printf '%s' "$clip" | wl-copy

  notify "Primary copied"
}

select_rofi() {
  [ -f "$histfile" ] || return 1

  selection="$(
    tac "$histfile" |
      while IFS= read -r line; do
        decode "$line"
        printf '\n'
      done |
      rofi -dmenu -i -p "Clipboard"
  )"

  [ -z "${selection:-}" ] && return 0

  printf '%s' "$selection" | wl-copy

  notify "Copied from history"
}

select_fzf_preview() {
  [ -f "$histfile" ] || return 1

  selected="$(
    tac "$histfile" |
      fzf \
        --layout=reverse \
        --border=rounded \
        --height=90% \
        --ansi \
        --preview-window=right:60%:wrap \
        --preview '
          content=$(printf "%s" {} | base64 -d 2>/dev/null)

          if command -v highlight >/dev/null 2>&1; then
            printf "%s\n" "$content" | highlight -O ansi 2>/dev/null \
              || printf "%s\n" "$content"
          else
            printf "%s\n" "$content"
          fi
        ' \
        --with-nth=1 \
        --bind "ctrl-u:preview-page-up,ctrl-d:preview-page-down" \
        --preview-label=" Clipboard "
  )"

  [ -z "${selected:-}" ] && return 0

  decode "$selected" | wl-copy

  notify "Copied (fzf preview)"
}

select_del_fzf_preview() {
  [ -f "$histfile" ] || return 1

  selected="$(
    tac "$histfile" |
      fzf \
        --multi \
        --layout=reverse \
        --border=rounded \
        --height=90% \
        --ansi \
        --preview-window=right:60%:wrap \
        --preview '
          content=$(printf "%s" {} | base64 -d 2>/dev/null)

          if command -v highlight >/dev/null 2>&1; then
            printf "%s\n" "$content" | highlight -O ansi 2>/dev/null \
              || printf "%s\n" "$content"
          else
            printf "%s\n" "$content"
          fi
        '
  )"

  [ -z "${selected:-}" ] && return 0

  tmp="$(mktemp)"

  # build delete list
  printf "%s\n" "$selected" | sort -u >"$tmp.del"

  # rebuild history without selected
  grep -Fvx -f "$tmp.del" "$histfile" >"$tmp.new" || true

  mv "$tmp.new" "$histfile"
  rm -f "$tmp.del"

  notify "Deleted selected items"
}

case "${1:-}" in
watch)
  wl-paste --watch bash -c "$0 ingest"
  ;;

ingest)
  capture_clipboard || exit 0
  write_history
  ;;

add)
  clip="$(wl-paste --primary 2>/dev/null || true)"
  [ -z "${clip:-}" ] && exit 1

  printf '%s' "$clip" | wl-copy

  write_history

  notify "Saved selection"
  ;;

out)
  clip="$(wl-paste 2>/dev/null || true)"
  [ -z "${clip:-}" ] && exit 1

  write_history

  notify "Saved clipboard"
  ;;

sel)
  select_rofi
  ;;

preview)
  select_fzf_preview
  ;;

del)
  select_del_fzf_preview
  ;;

*)
  cat <<EOF
Usage:
  clip watch     Start Wayland watcher
  clip add       Save primary selection
  clip out       Save clipboard
  clip sel       rofi history
  clip preview   fzf copy (colored)
  clip del       fzf delete (colored)
EOF
  ;;
esac

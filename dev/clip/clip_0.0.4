#!/usr/bin/env bash
# sway-clipboard-rofi-multiline-fix.sh
# Clipboard manager for Sway, handles multi-line correctly

CLIP_FILE="$HOME/.cache/cliphistory.txt"
DELIM="__CLIP_DELIM__"

mkdir -p "$(dirname "$CLIP_FILE")"
touch "$CLIP_FILE"

# Add clipboard entry
add_clipboard() {
    local new_clip="$1"
    [[ -z "$new_clip" ]] && return

    # Read last entry
    local last_entry=$(tail -n 1 "$CLIP_FILE")
    if [[ "$last_entry" != "$new_clip" ]]; then
        # Save using delimiter
        echo -e "$new_clip\n$DELIM" >> "$CLIP_FILE"

        # Keep last 100 entries (by delimiter)
        awk -v delim="$DELIM" 'BEGIN{RS=delim; ORS=delim} NR>NF-100 {print}' "$CLIP_FILE" > "$CLIP_FILE.tmp" 2>/dev/null || true
        mv "$CLIP_FILE.tmp" "$CLIP_FILE" 2>/dev/null || true
    fi
}

# Background watcher
if [[ "$1" == "watch" ]]; then
    LAST=""
    while true; do
        CURRENT=$(wl-paste -n 2>/dev/null || echo "")
        if [[ -n "$CURRENT" && "$CURRENT" != "$LAST" ]]; then
            add_clipboard "$CURRENT"
            LAST="$CURRENT"
        fi
        sleep 0.5
    done
    exit
fi

# Show Rofi menu
CHOICES=$(awk -v RS="$DELIM" 'NR>0{print}' "$CLIP_FILE" | tac)
CHOICE=$(echo "$CHOICES" | rofi -dmenu -i -p "Clipboard:")

# Copy selection back
if [[ -n "$CHOICE" ]]; then
    echo -n "$CHOICE" | wl-copy
fi
